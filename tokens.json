{
  "$schema": "https://schemas.tokens.studio/latest/tokens.schema.json",
  "$figma": {
    "fileKey": "zjD9Ey6snTlceLpQb3YiHU",
    "collectionId": "VariableCollectionId:8:2943",
    "collectionName": "skruglov.com",
    "modes": { "Light": "8:0", "Dark": "8:1" },
    "variables": {
      "color/text/primary":   "VariableID:8:2944",
      "color/text/secondary": "VariableID:8:2945",
      "color/text/muted":     "VariableID:8:2946",
      "color/border/subtle":  "VariableID:8:2947",
      "color/bg/page":        "VariableID:8:2948",
      "color/bg/surface":     "VariableID:8:2949",
      "color/placeholder":    "VariableID:8:2950",
      "type/size/sm":         "VariableID:8:2951",
      "type/size/base":       "VariableID:8:2952",
      "type/size/xl":         "VariableID:8:2953",
      "type/size/4xl":        "VariableID:8:2954",
      "type/lineHeight/sm":   "VariableID:8:2955",
      "type/lineHeight/base": "VariableID:8:2956",
      "type/lineHeight/heading": "VariableID:8:2957",
      "type/letterSpacing/heading": "VariableID:8:2958",
      "spacing/2":            "VariableID:8:2959",
      "spacing/4":            "VariableID:8:2960",
      "spacing/5":            "VariableID:8:2961",
      "spacing/6":            "VariableID:8:2962",
      "spacing/8":            "VariableID:8:2963",
      "spacing/12":           "VariableID:8:2964",
      "spacing/16":           "VariableID:8:2965",
      "spacing/24":           "VariableID:8:2966",
      "layout/container/width":  "VariableID:8:2967",
      "layout/container/offset": "VariableID:8:2968",
      "radius/sm":            "VariableID:8:2969",
      "radius/md":            "VariableID:8:2970",
      "radius/full":          "VariableID:8:2971",
      "font/body":            "VariableID:8:2972",
      "font/heading":         "VariableID:8:2973"
    }
  },
  "global": {
    "color": {
      "text": {
        "primary": {
          "$value": "#000000",
          "$type": "color",
          "$description": "text-black / dark:text-white",
          "dark": "#ffffff",
          "css": "color: var(--color-text-primary)",
          "tailwind": "text-black dark:text-white"
        },
        "secondary": {
          "$value": "rgba(0,0,0,0.5)",
          "$type": "color",
          "$description": "text-black/50 — labels, meta fields",
          "dark": "rgba(255,255,255,0.5)",
          "css": "color: var(--color-text-secondary)",
          "tailwind": "text-black/50 dark:text-white/50"
        },
        "muted": {
          "$value": "rgba(0,0,0,0.44)",
          "$type": "color",
          "$description": "text-black/44 — breadcrumb current, footer details",
          "dark": "rgba(255,255,255,0.44)",
          "css": "color: var(--color-text-muted)",
          "tailwind": "text-black/44 dark:text-white/44"
        }
      },
      "border": {
        "subtle": {
          "$value": "rgba(0,0,0,0.1)",
          "$type": "color",
          "$description": "border-black/10 — dividers, button borders",
          "dark": "rgba(255,255,255,0.1)",
          "css": "border-color: var(--color-border-subtle)",
          "tailwind": "border-black/10 dark:border-white/10"
        }
      },
      "bg": {
        "page": {
          "$value": "#ffffff",
          "$type": "color",
          "$description": "bg-white / dark:bg-stone-900",
          "dark": "#1c1917",
          "css": "background-color: var(--color-bg-page)",
          "tailwind": "bg-white dark:bg-stone-900"
        },
        "surface": {
          "$value": "#f5f5f5",
          "$type": "color",
          "$description": "bg-[#F5F5F5] — CTA button, hover states",
          "dark": "#292524",
          "css": "background-color: var(--color-bg-surface)",
          "tailwind": "bg-[#F5F5F5] dark:bg-stone-800"
        }
      },
      "placeholder": {
        "$value": "#d9d9d9",
        "$type": "color",
        "$description": "bg-[#D9D9D9] — image and card placeholders",
        "dark": "#44403c",
        "css": "background-color: var(--color-placeholder)",
        "tailwind": "bg-[#D9D9D9] dark:bg-stone-700"
      }
    },
    "type": {
      "size": {
        "sm":   { "$value": 14,  "$type": "dimension", "tailwind": "text-sm",   "css": "font-size: var(--type-size-sm)" },
        "base": { "$value": 16,  "$type": "dimension", "tailwind": "text-base", "css": "font-size: var(--type-size-base)" },
        "xl":   { "$value": 28,  "$type": "dimension", "tailwind": "text-[28px]", "css": "font-size: var(--type-size-xl)" },
        "4xl":  { "$value": 36,  "$type": "dimension", "tailwind": "text-4xl",  "css": "font-size: var(--type-size-4xl)" }
      },
      "lineHeight": {
        "sm":      { "$value": 20, "$type": "dimension", "tailwind": "leading-5",      "css": "line-height: var(--type-lh-sm)" },
        "base":    { "$value": 24, "$type": "dimension", "tailwind": "leading-[1.5]",  "css": "line-height: var(--type-lh-base)" },
        "heading": { "$value": 42, "$type": "dimension", "tailwind": "leading-[1.167]","css": "line-height: var(--type-lh-heading)" }
      },
      "letterSpacing": {
        "heading": { "$value": -2.8, "$type": "dimension", "tailwind": "tracking-[-0.028em]", "css": "letter-spacing: var(--type-ls-heading)" }
      }
    },
    "spacing": {
      "2":  { "$value": 8,  "$type": "spacing", "tailwind": "p-2 / m-2 / gap-2" },
      "4":  { "$value": 16, "$type": "spacing", "tailwind": "p-4 / m-4 / gap-4" },
      "5":  { "$value": 20, "$type": "spacing", "tailwind": "px-5 / py-5" },
      "6":  { "$value": 24, "$type": "spacing", "tailwind": "p-6 / gap-6 / space-y-6" },
      "8":  { "$value": 32, "$type": "spacing", "tailwind": "p-8 / gap-8 / mt-8 / mb-8" },
      "12": { "$value": 48, "$type": "spacing", "tailwind": "pt-12 / pb-12" },
      "16": { "$value": 64, "$type": "spacing", "tailwind": "py-16 / mt-16 / pt-16" },
      "24": { "$value": 96, "$type": "spacing", "tailwind": "pb-24" }
    },
    "layout": {
      "container": {
        "width":  { "$value": 580, "$type": "dimension", "css": "w-[580px]" },
        "offset": { "$value": 350, "$type": "dimension", "note": "Left margin at 1280px viewport: (1280-580)/2" }
      }
    },
    "radius": {
      "sm":   { "$value": 8,    "$type": "borderRadius", "tailwind": "rounded-lg", "usage": "thumbnails, More Projects cards, logo" },
      "md":   { "$value": 12,   "$type": "borderRadius", "tailwind": "rounded-[12px]", "usage": "gallery images (prose-img:rounded-[12px])" },
      "full": { "$value": 9999, "$type": "borderRadius", "tailwind": "rounded-full", "usage": "pill buttons (Visit project, Start a conversation)" }
    },
    "font": {
      "body":    { "$value": "Die Grotesk B", "$type": "fontFamilies", "tailwind": "font-grotesk / font-sans", "css": "font-family: var(--font-body)" },
      "heading": { "$value": "Tiempos Text",  "$type": "fontFamilies", "tailwind": "font-tiempos / font-serif", "css": "font-family: var(--font-heading)" }
    }
  },
  "$sync": {
    "description": "Design token sync workflow: Figma Variables ↔ codebase",
    "steps": [
      "1. Edit values in Figma Variables panel (skruglov.com collection)",
      "2. Export updated variables using Tokens Studio plugin or REST API",
      "3. Run: node scripts/sync-tokens.js to update global.css custom properties",
      "4. Commit and push — Tailwind picks up CSS custom properties automatically"
    ],
    "cssOutputFile": "src/styles/tokens.css",
    "figmaFileUrl": "https://www.figma.com/design/zjD9Ey6snTlceLpQb3YiHU"
  }
}
