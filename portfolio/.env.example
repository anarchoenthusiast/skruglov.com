# Public deployment settings; never commit SMTP credentials.
BLOCK_SEARCH_INDEXING=true
# Optional override: brightfutures | editorial | midnight
# SITE_THEME=brightfutures

# SMTP credentials belong in .env.local or the hosting provider's secret store.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO=
# Existing MIGADU_SMTP_USER/PASS/FROM deployments remain supported.

# Optional: include the QA style editor in a production preview build.
# Development always includes it; leave unset for normal public builds.
# ENABLE_TEMPLATE_STUDIO=true
