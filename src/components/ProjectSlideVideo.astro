---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: string;
  poster?: ImageMetadata;
  alt: string;
  posterWidth?: number;
  controls?: boolean;
  muted?: boolean;
  loop?: boolean;
}

const {
  src,
  poster,
  alt,
  posterWidth = 1000,
  controls = false,
  muted = true,
  loop = true,
} = Astro.props;
const optimizedPoster = poster
  ? await getImage({ src: poster, width: posterWidth, quality: 70, format: "webp" })
  : undefined;
---

<div class="project-slide-wrap">
  <video
    class="project-slide"
    data-src={src}
    poster={optimizedPoster?.src}
    data-project-video
    playsinline
    preload="none"
    controls={controls}
    muted={muted}
    loop={loop}
    width="960"
    height="640"
    aria-label={alt}
  />
</div>
