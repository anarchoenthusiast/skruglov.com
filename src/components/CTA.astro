---
import Container from "./Container.astro";

interface Props {
  size?: "default" | "blog" | "project";
}

const { size = "default" } = Astro.props;

// Мапим размер blog на blog-mobile для единообразных отступов
const containerSize = size === "blog" ? "blog-mobile" : size;
---

<section class="cta pt-12 pb-0">
  <Container size={containerSize}>
    <div class="flex flex-col items-center border-t border-black/10 dark:border-white/10 pt-12">
      <div class="flex flex-col gap-6 w-full mb-8 animate sm:px-6">
        <div class="w-full">
          <h1 class="text-center font-tiempos text-4xl font-normal text-black dark:text-white tracking-[-0.028em] leading-[1.167]">
            Have an idea<br/>worth shaping?
          </h1>
        </div>
        <div class="flex justify-center items-center w-full">
          <p class="text-center font-grotesk text-base leading-[1.5] text-black dark:text-white max-w-[580px] mx-auto px-0">
            I help founders turn early signals into clear, usable products - from product direction and UX to interface design, frontend, and AI-powered workflows.<br/><br/>
            My work has helped products reach millions of users and has been featured in <a href="https://www.forbes.com/sites/bernardmarr/2023/02/28/beyond-chatgpt-14-mind-blowing-ai-tools-everyone-should-be-trying-out-now/" target="_blank" rel="noopener noreferrer" class="press-mention">Forbes</a>, <a href="https://www.billboard.com/p/ai-tools-music-directory/" target="_blank" rel="noopener noreferrer" class="press-mention">Billboard</a>, <a href="https://www.thetimes.com/static/ai-artificial-intelligence-technology-hurst-business/" target="_blank" rel="noopener noreferrer" class="press-mention">The Times</a>, <a href="https://winners.webbyawards.com/winners/apps-software-immersive/app-excellence/best-use-of-ai-machine-learning?years=0&sort=0" target="_blank" rel="noopener noreferrer" class="press-mention">Webby Awards</a>, <a href="https://ca.pcmag.com/video-streaming-services/7711/how-to-download-youtube-videos" target="_blank" rel="noopener noreferrer" class="press-mention">PCMag</a>, <a href="https://thenextweb.com/news/theres-an-actual-science-to-good-instagram-photos" target="_blank" rel="noopener noreferrer" class="press-mention">TNW</a>, <a href="https://www.techadvisor.com/article/1391140/how-to-split-an-audio-track-online-with-lalal-ai.html" target="_blank" rel="noopener noreferrer" class="press-mention">Tech Advisor</a>, <a href="https://www.musicradar.com/music-tech/lalal-ai-brings-its-ai-powered-stem-separation-into-your-daw-with-its-first-plugin" target="_blank" rel="noopener noreferrer" class="press-mention">MusicRadar</a>, and <a href="https://www.instagram.com/p/CKUCJiQihDX/" target="_blank" rel="noopener noreferrer" class="press-mention">Golden Kitty Award</a>.
          </p>
        </div>
      </div>
      <a href="mailto:hello@skruglov.com" class="px-5 py-3 bg-[#F5F5F5] dark:bg-stone-800 hover:bg-stone-200 dark:hover:bg-stone-700 rounded-full font-grotesk text-base text-black dark:text-white transition-colors animate">
        Start a conversation
      </a>
    </div>
  </Container>
</section>

<style>
  .cta {
    max-width: 100%;
    overflow-x: hidden;
  }
  
  .font-tiempos {
    font-family: 'Tiempos Text', serif;
    font-weight: 400;
    letter-spacing: -0.028em;
  }
  
  .font-grotesk {
    font-family: 'Die Grotesk B', sans-serif;
    font-weight: 400;
  }

  .press-mention {
    @apply text-black dark:text-white underline decoration-black/25 dark:decoration-white/25 underline-offset-2;
    @apply hover:decoration-black dark:hover:decoration-white transition-colors;
  }
</style> 