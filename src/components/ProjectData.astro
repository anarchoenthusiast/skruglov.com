<div class="project-data not-prose my-6 font-grotesk text-base font-normal leading-[1.5] text-black dark:text-white">
  <slot />
</div>

<style>
  .project-data :global(dl) {
    @apply m-0;
  }

  .project-data :global(dl > div) {
    @apply grid grid-cols-3 gap-4 border-b border-black/10 dark:border-white/10 py-1;
  }

  .project-data :global(dt) {
    @apply min-w-0 text-black/50 dark:text-white/50;
  }

  .project-data :global(dd) {
    @apply col-span-2 m-0 min-w-0 text-right;
    overflow-wrap: anywhere;
  }

  .project-data :global(p) {
    @apply m-0;
  }

  .project-data :global(table) {
    @apply w-full table-fixed border-collapse;
  }

  .project-data :global(tr) {
    @apply border-b border-black/10 dark:border-white/10;
  }

  .project-data :global(th),
  .project-data :global(td) {
    @apply py-1 align-top text-left font-normal;
    overflow-wrap: anywhere;
  }

  .project-data :global(th) {
    @apply text-black/50 dark:text-white/50;
  }

  .project-data :global(th:not(:last-child)),
  .project-data :global(td:not(:last-child)) {
    @apply pr-4;
  }
</style>
