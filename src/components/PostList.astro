---
import type { CollectionEntry } from "astro:content";
import PostCard from "./PostCard.astro";

interface Props {
  title: string;
  posts: CollectionEntry<"blog">[];
  seeAllLink?: string;
  seeAllText?: string;
  fromSource?: string;
}

const { title, posts, seeAllLink, seeAllText = "All writing", fromSource = "home" } = Astro.props;
---

<section class="animate space-y-4">
  <div class="mb-2">
    <h2 class="font-grotesk font-normal text-base text-black/44 dark:text-white/44">
      {title}
    </h2>
  </div>
  <ul class="flex flex-col gap-2">
    {posts.map(post => (
      <PostCard post={post} fromSource={fromSource} />
    ))}
  </ul>
  {seeAllLink && (
    <div class="flex justify-end pt-2">
      <a href={seeAllLink} class="action-link">
        <span class="action-link-label">{seeAllText}</span>
        <svg class="action-link-arrow" viewBox="0 0 5 12" fill="none" aria-hidden="true">
          <path d="M1 1.5L4 6L1 10.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  )}
</section>
